# Copiá este archivo como .env.local y completá con tus valores reales.
# Next.js carga automáticamente .env.local en desarrollo y en build de producción.

# Número de WhatsApp en formato internacional sin signos (ej: 5491100000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000

# ID del formulario de Jotform (Publish > Embed > Iframe)
NEXT_PUBLIC_JOTFORM_ID=YOUR_JOTFORM_ID

# URL de tu Calendly (ej: https://calendly.com/tu-usuario/30min)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/tu-usuario/30min

# Google Analytics 4 - Measurement ID (ej: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager - Container ID (ej: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Email de contacto
NEXT_PUBLIC_CONTACT_EMAIL=hola@digitalculture.com
